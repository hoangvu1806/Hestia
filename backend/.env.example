HESTIA_ENVIRONMENT=local
HESTIA_HOST=0.0.0.0
HESTIA_PORT=8484
HESTIA_LOG_LEVEL=INFO
HESTIA_CORS_ORIGINS=http://localhost:3434,http://127.0.0.1:3434
HESTIA_FIREBASE_PROJECT_ID=hestia-4409b
HESTIA_FIREBASE_CREDENTIALS_PATH=secrets/firebase/service-account.json
HESTIA_THEMEALDB_API_KEY=1
HESTIA_USDA_API_KEY=DEMO_KEY

# Root uses the vision-capable model; specialist agents use the analysis model.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_MODEL_1=openrouter/google/gemini-3.5-flash-lite
CUSTOM_LLM_MODEL_2=openrouter/qwen/qwen3.6-35b-a3b
CUSTOM_IMAGE_GEN_MODEL_NAME=openrouter/openai/gpt-image-2

# Ai2 Asta MCP key for Semantic Scholar paper and snippet retrieval.
ASTA_API_KEY=

# Required PostgreSQL database for ADK sessions and the food-intelligence schema.
# Sessions are partitioned by the verified Firebase UID. Percent-encode reserved password chars.
HESTIA_SESSION_DATABASE_URL=

# Private S3-compatible storage for uploaded and AI-generated chat images.
HESTIA_S3_ENDPOINT_URL=http://100.x.x.x:9000
HESTIA_S3_ACCESS_KEY_ID=
HESTIA_S3_SECRET_ACCESS_KEY=
HESTIA_S3_BUCKET=hestia
HESTIA_S3_REGION=us-east-1
