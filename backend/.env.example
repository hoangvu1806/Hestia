HESTIA_ENVIRONMENT=local
HESTIA_HOST=0.0.0.0
HESTIA_PORT=8484
HESTIA_LOG_LEVEL=INFO
HESTIA_CORS_ORIGINS=http://localhost:3434,http://127.0.0.1:3434

# Root uses the vision-capable model; specialist agents use the analysis model.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_MODEL_1=openrouter/google/gemini-3.5-flash-lite
CUSTOM_LLM_MODEL_2=openrouter/qwen/qwen3.6-35b-a3b

# Ai2 Asta MCP key for Semantic Scholar paper and snippet retrieval.
ASTA_API_KEY=

# Development identity and persistent ADK session storage.
HESTIA_DEFAULT_USER_ID=local-user
HESTIA_SESSION_DB_PATH=.runtime/sessions.sqlite3
