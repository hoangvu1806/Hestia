{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hestia",
  "version": "1.0.0",
  "identifier": "space.vectorium.hestia",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3500",
    "beforeBuildCommand": "node scripts/build-app.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Hestia",
        "width": 420,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "userAgent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0.0.0 Mobile Safari/537.36 HestiaApp/1.0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Culinary intelligence and food-safety assistant",
    "longDescription": "Hestia combines ingredient recognition, food chemistry and evidence-aware food-safety guidance.",
    "category": "Food",
    "publisher": "Vectorium",
    "copyright": "© Vectorium"
  }
}
