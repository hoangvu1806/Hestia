# Copy this file to .env before running Docker Compose.

POSTGRES_DB=hestia
POSTGRES_USER=hestia
POSTGRES_PASSWORD=replace-with-a-long-random-password
HESTIA_SESSION_DATABASE_URL=postgresql+asyncpg://hestia:replace-with-a-url-encoded-password@postgres:5432/hestia

# Private MinIO/S3 storage. Use the endpoint reachable from the backend host.
HESTIA_S3_ENDPOINT_URL=http://100.x.x.x:9000
HESTIA_S3_ACCESS_KEY_ID=
HESTIA_S3_SECRET_ACCESS_KEY=
HESTIA_S3_BUCKET=hestia
HESTIA_S3_REGION=us-east-1

HESTIA_HTTP_PORT=8080
HESTIA_CORS_ORIGINS=http://localhost:8080
HESTIA_ENV_FILE=./backend/.env
FIREBASE_SERVICE_ACCOUNT_FILE=./backend/secrets/firebase/service-account.json

# Set these to GHCR image references to deploy prebuilt images without rebuilding.
HESTIA_BACKEND_IMAGE=hestia-backend:local
HESTIA_FRONTEND_IMAGE=hestia-frontend:local

# Public Firebase web application configuration. These values are embedded in the frontend image.
NEXT_PUBLIC_SITE_URL=https://hestia.example.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
